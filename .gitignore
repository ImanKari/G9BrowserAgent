# Secrets — never commit these.
.azpat
*.pat
.env
.env.*
!.env.example

# Both carry an absolute, per-machine path — .mcp.json is the Claude Code
# project config, setup/mcp.json is generated by install.ps1. Committing one
# machine's path just confuses the next.
setup/mcp.json
.mcp.json

# Node
node_modules/
npm-debug.log*
# The core has no dependencies, so no lock file. desktop/package-lock.json IS tracked: CI installs
# exactly those versions (npm ci), and the version check compares it.
/package-lock.json

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Logs and scratch
*.log
tmp/
scratch/

# Visual Studio
.vs/

# Artefacts the browser writes back through serve.mjs /save.
setup/out/
