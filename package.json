{
  "name": "g9browseragent",
  "version": "3.3.0",
  "private": true,
  "description": "G9BrowserAgent v2: a local daemon (g9d) that lets any number of AI agents drive two browser engines — the extension in your own browser, and real Chrome/Edge it launches — through one MCP shim. Zero dependencies outside desktop/.",
  "license": "MIT",
  "author": {
    "name": "Iman Kari",
    "email": "iman.kari@live.com"
  },
  "homepage": "https://github.com/ImanKari/G9BrowserAgent",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImanKari/G9BrowserAgent.git"
  },
  "bugs": {
    "url": "https://github.com/ImanKari/G9BrowserAgent/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "g9d": "daemon/g9d.mjs",
    "g9-mcp": "mcp/shim.mjs",
    "g9": "runner/g9.mjs"
  },
  "scripts": {
    "check": "node setup/check.mjs",
    "check:all": "node setup/check.mjs --all",
    "check:release": "node setup/check.mjs --release",
    "test": "node setup/unittest.mjs && node setup/selftest.mjs && node setup/extensiontest.mjs",
    "test:unit": "node setup/unittest.mjs",
    "test:self": "node setup/selftest.mjs",
    "test:ext": "node setup/extensiontest.mjs",
    "test:engine2": "node setup/engine2-livetest.mjs",
    "test:live": "node setup/isolated-livetest.mjs",
    "test:stealth": "node setup/stealthtest.mjs",
    "bench": "node setup/bench.mjs",
    "matrix": "node setup/matrix.mjs",
    "endurance": "node setup/endurance.mjs",
    "daemon": "node daemon/g9d.mjs --foreground",
    "shim": "node mcp/shim.mjs"
  }
}
