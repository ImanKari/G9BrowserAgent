{
  "manifest_version": 3,
  "name": "G9 Browser Agent",
  "version": "1.5.1",
  "description": "Gives an AI agent full DevTools-level control over your real browser tabs — inspect, debug, and interact with trusted input events.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "cookies",
    "storage",
    "alarms",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "G9 Browser Agent — click to open control panel"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "icons": {
    "16": "panel/icon16.png",
    "48": "panel/icon48.png",
    "128": "panel/icon128.png"
  }
}
